# Server
NODE_ENV=production
PORT=3000
CODE_PEPPER=replace-with-long-random-secret
PUBLIC_BASE_URL=https://api.your-domain.co.il

# Mobile app build: must point to the public HTTPS server
ORDERPILOT_API_BASE_URL=https://api.your-domain.co.il
ORDERPILOT_ENV=production

# Desktop app
# local = desktop starts the bundled Node server locally
# remote = desktop opens the central server admin panel
ORDERPILOT_DESKTOP_MODE=remote
ORDERPILOT_SERVER_URL=https://api.your-domain.co.il
ORDERPILOT_DESKTOP_PORT=3000

# Desktop installer code signing (optional, but required to avoid Windows SmartScreen /
# Smart App Control blocking the installer). Set once you have a code-signing certificate
# from a CA (DigiCert, Sectigo, SSL.com, ...). CSC_LINK can be a local .pfx file path or a
# base64-encoded .pfx string; leave both unset to build an unsigned installer.
# CSC_LINK=C:\path\to\certificate.pfx
# CSC_KEY_PASSWORD=your-certificate-password
