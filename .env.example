# Server
NODE_ENV=production
PORT=3000
CODE_PEPPER=replace-with-long-random-secret
PUBLIC_BASE_URL=https://api.your-domain.co.il

# Mobile app build: must point to the public HTTPS server
ORDERPILOT_API_BASE_URL=https://api.your-domain.co.il
ORDERPILOT_ENV=production

# Desktop app
# local = desktop starts the bundled Node server locally
# remote = desktop opens the central server admin panel
ORDERPILOT_DESKTOP_MODE=remote
ORDERPILOT_SERVER_URL=https://api.your-domain.co.il
ORDERPILOT_DESKTOP_PORT=3000
