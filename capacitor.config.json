{
  "appId": "com.orderpilot.store",
  "appName": "OrderPilot Store",
  "webDir": "public",
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#2563eb",
      "sound": "default"
    }
  }
}